<script>
import file from "@system.file"
import shellData from "./common/scripts/shellData.js"

export default {
  shellData: shellData,
  onCreate() {
    file.writeText({
      uri: "internal://files/cmd_result.json",
      text: '{"seq":-1}',
      append: false
    })
    console.log("Shell++ project created")
  },
  onDestroy() {
    console.log("Shell++ project destroyed")
  }
}
</script>
