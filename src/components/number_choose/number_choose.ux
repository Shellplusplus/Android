<template>
  <div show="{{display}}" class="number_choose" style="{{style}}">
    <img static onclick="minus" onlongpress="minusL" ontouchend="end"
         src="/common/minis.png"
         class="nc-btn nc-btn-minus"/>
    <img static onclick="add" onlongpress="addL" ontouchend="end"
         src="/common/plus.png"
         class="nc-btn nc-btn-plus"/>
    <text class="nc-value">{{ value_ + unit }}</text>
    <text class="nc-name">{{ name }}</text>
  </div>
</template>

<script>
var interval = null

export default {
  props: {
    max: { default: 100 },
    min: { default: 0 },
    step: { default: 1 },
    value: { default: 0 },
    name: { default: "名称" },
    unit: { type: String, default: "" },
    style: { default: "" },
    display: { default: true }
  },
  data() {
    return { value_: this.value }
  },
  onInit() { this.value_ = this.value },
  add() {
    if (this.value_ < this.max) { this.value_ += parseFloat(this.step) }
    this.$emit("change", { value: this.value_ })
  },
  minus() {
    if (this.value_ > this.min) { this.value_ -= parseFloat(this.step) }
    this.$emit("change", { value: this.value_ })
  },
  addL() {
    this.end()
    interval = setInterval(() => { this.add() }, 50)
  },
  minusL() {
    this.end()
    interval = setInterval(() => { this.minus() }, 50)
  },
  end() {
    if (interval) { clearInterval(interval); interval = null }
  }
}
</script>

<style>
.number_choose { width: 336px; height: 102px; flex-direction: row; align-items: center; justify-content: center; }
.nc-btn { position: absolute; width: 72px; height: 72px; }
.nc-btn-minus { left: 6px; }
.nc-btn-plus { left: 258px; }
.nc-value { position: absolute; left: 78px; top: 39px; width: 180px; text-align: center; font-size: 28px; font-weight: bold; color: #ffffff; }
.nc-name { position: absolute; left: 78px; top: 1px; width: 180px; text-align: center; font-size: 22px; font-weight: bold; color: #999999; }
@media (shape: pill-shaped) {
  .number_choose { width: 192px; height: 102px; }
  .nc-btn { width: 52px; height: 52px; }
  .nc-btn-minus { left: 4px; }
  .nc-btn-plus { left: 136px; }
  .nc-value { left: 56px; top: 30px; width: 80px; font-size: 22px; }
  .nc-name { left: 56px; top: 1px; width: 80px; font-size: 18px; }
}
</style>
