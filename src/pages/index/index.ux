<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title" onclick="onTitleTap">{{ $t("index.title") }}</text>
        <img src="/common/back.png" class="hd-back" />
        <img src="/common/More_B@1x.png" @click="goAbout" class="hd-more" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goAbout">
          <div class="pill-more"></div>
        </div>
      </div>

      <div class="scroll-inner">

        <!-- 连接状态 -->
        <div class="card" onclick="goDetail">
          <div class="card-left">
            <text class="card-label">{{ $t("index.status") }}</text>
            <text class="card-sub">{{ statusText }}</text>
          </div>
        </div>

        <!-- 终端 -->
        <div class="card card-primary" onclick="goTerminal">
          <div class="card-left">
            <text class="card-label">{{ $t("index.terminal") }}</text>
            <text class="card-sub card-sub-primary">{{ $t("index.terminalDesc") }}</text>
          </div>
        </div>

        <!-- 截图 -->
        <div class="card" onclick="goScreenshot">
          <div class="card-left">
            <text class="card-label">{{ $t("index.screenshot") }}</text>
            <text class="card-sub">{{ $t("index.screenshotDesc") }}</text>
          </div>
        </div>

        <!-- 设置 -->
        <div class="card" onclick="goSettings">
          <div class="card-left">
            <text class="card-label">{{ $t("index.settings") }}</text>
            <text class="card-sub">{{ $t("index.settingsDesc") }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

var SYSINFO_FILE = "internal://files/system_info.json"

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    sysTimer: null,
    statusText: "",
    titleTapCount: 0,
    titleTapTimer: null
  },

  onInit() {
    var self = this
    self.updateTime()
    self.statusText = self.$t("index.waitingConnection")
    self.timer = setInterval(function() { self.updateTime() }, 1000)
  },

  onShow() {
    var self = this
    self.checkConn()
    if (!self.sysTimer) {
      self.sysTimer = setInterval(function() { self.checkConn() }, 5000)
    }
  },

  onHide() {
    if (this.sysTimer) {
      clearInterval(this.sysTimer)
      this.sysTimer = null
    }
  },

  onDestroy() {
    clearInterval(this.timer)
    if (this.sysTimer) {
      clearInterval(this.sysTimer)
    }
    if (this.titleTapTimer) {
      clearTimeout(this.titleTapTimer)
    }
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  resetTitleTap() {
    this.titleTapCount = 0
    if (this.titleTapTimer) {
      clearTimeout(this.titleTapTimer)
      this.titleTapTimer = null
    }
  },

  onTitleTap() {
    var self = this
    self.titleTapCount = self.titleTapCount + 1
    if (self.titleTapTimer) {
      clearTimeout(self.titleTapTimer)
    }
    self.titleTapTimer = setTimeout(function() {
      self.resetTitleTap()
    }, 1500)
    if (self.titleTapCount < 10) {
      return
    }
    self.resetTitleTap()
    router.push({ uri: "/pages/debug" })
  },

  checkConn() {
    var self = this
    file.readText({
      uri: SYSINFO_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          if (json._init) {
            self.statusText = self.$t("index.disconnected")
            return
          }
          /* 检查心跳是否超时（超过 15 秒视为断开） */
          if (json.timestamp) {
            var now = Math.floor(Date.now() / 1000)
            var ts = parseInt(json.timestamp)
            if (isNaN(ts)) {
              self.statusText = self.$t("index.disconnected")
              return
            }
            if (now - ts > 15) {
              self.statusText = self.$t("index.disconnected")
              return
            }
          }
          self.statusText = self.$t("index.connected")
        } catch(e) {
          /* 心跳文件损坏或格式异常 */
          self.statusText = self.$t("index.disconnected")
        }
      },
      fail: function() {
        self.statusText = self.$t("index.disconnected")
      }
    })
  },

  goTerminal() { router.push({ uri: "/pages/terminal" }) },
  goScreenshot() { router.push({ uri: "/pages/screenshot" }) },
  goDetail()   { router.push({ uri: "/pages/detail" }) },
  goSettings() { router.push({ uri: "/pages/settings" }) },
  goAbout()    { router.push({ uri: "/pages/about" }) },
  goBack()     { router.back() }
}
</script>

<style>
@import '../../common/card.css';

.page { width: 336px; height: 480px; background-color: #000000; }
.content-full { width: 336px; height: 480px; flex-direction: column; }
.header-area { width: 336px; height: 102px; position: relative; }
.header-bg { width: 336px; height: 102px; }
.hd-title { position: absolute; left: 78px; top: 35px; width: 180px; height: 42px; text-align: center; font-size: 32px; font-weight: bold; color: #ffffff; }
.hd-back { position: absolute; left: 6px; top: 6px; width: 72px; height: 72px; }
.hd-time { position: absolute; left: 78px; top: 7px; width: 180px; height: 32px; text-align: center; font-size: 24px; font-weight: bold; color: rgba(255,255,255,0.6); }
.hd-more { position: absolute; left: 258px; top: 6px; width: 72px; height: 72px; }
.pill-header { display: none; }
.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .page { width: 192px; height: 490px; }
  .content-full { width: 192px; height: 490px; }
  .header-area { display: none; }
  .pill-header { display: flex; width: 192px; height: 92px; flex-direction: column; align-items: center; justify-content: flex-start; }
  .pill-more-wrap { width: 102px; height: 72px; border-radius: 36px; flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
  .pill-more { width: 102px; height: 72px; border-radius: 36px; background-image: url(/common/more_capsule.png); background-size: 102px 72px; }
  .scroll-inner { padding: 0 4px 16px 4px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .page { width: 212px; height: 520px; }
  .content-full { width: 212px; height: 520px; }
  .header-area { display: none; }
  .pill-header { display: flex; width: 212px; height: 92px; flex-direction: column; align-items: center; justify-content: flex-start; }
  .pill-more-wrap { width: 102px; height: 72px; border-radius: 36px; flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
  .pill-more { width: 102px; height: 72px; background-image: url(/common/more_capsule.png); background-size: 102px 72px; border-radius: 36px; }
  .scroll-inner { padding: 0 4px 16px 4px; }
}
</style>
