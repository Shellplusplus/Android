<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ $t("detail.title") }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>
      <div class="scroll-inner">

        <div class="card card-primary" onclick="refresh">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.status") }}</text>
            <text class="card-sub card-sub-primary">{{ luaConnected ? $t("detail.connected") : $t("detail.disconnected") }}</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.lastSync") }}</text>
            <text class="card-sub">{{ lastHeartbeat || $t("detail.none") }}</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.dataDir") }}</text>
            <text class="card-sub">/data/quickapp/files/com.shell.liangyi/</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.luaBackend") }}</text>
            <text class="card-sub">{{ luaConnected ? $t("detail.running") : $t("detail.stopped") }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

var SYSINFO_FILE = "internal://files/system_info.json"

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    refreshTimer: null,
    luaConnected: false,
    lastHeartbeat: ""
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
  },

  onShow() {
    var self = this
    self.refresh()
    if (!self.refreshTimer) {
      self.refreshTimer = setInterval(function() { self.refresh() }, 2000)
    }
  },

  onHide() {
    if (this.refreshTimer) {
      clearInterval(this.refreshTimer)
      this.refreshTimer = null
    }
  },

  onDestroy() {
    clearInterval(this.timer)
    if (this.refreshTimer) {
      clearInterval(this.refreshTimer)
    }
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  refresh() {
    var self = this
    file.readText({
      uri: SYSINFO_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          if (json._init) {
            self.luaConnected = false
            self.lastHeartbeat = ""
            return
          }
          if (json.timestamp) {
            var now = Math.floor(Date.now() / 1000)
            var ts = parseInt(json.timestamp)
            if (isNaN(ts)) {
              self.luaConnected = false
              self.lastHeartbeat = ""
              return
            }
            if (now - ts > 15) {
              self.luaConnected = false
              self.lastHeartbeat = json.timestamp + " (" + self.$t("detail.timeout") + ")"
              return
            }
          }
          /* Unix 时间戳转为可读格式 */
          self.luaConnected = true
          var ht = parseInt(json.timestamp)
          if (!isNaN(ht)) {
            var d = new Date(ht * 1000)
            self.lastHeartbeat = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) + ":" + ("0" + d.getSeconds()).slice(-2)
          } else {
            self.lastHeartbeat = json.timestamp || self.$t("detail.unknown")
          }
        } catch(e) {
          /* 心跳文件损坏或格式异常 */
          self.luaConnected = false
          self.lastHeartbeat = ""
        }
      },
      fail: function() {
        self.luaConnected = false
        self.lastHeartbeat = ""
      }
    })
  },

  goBack() { router.back() }
}
</script>

<style>
@import '../../common/back-page.css';
@import '../../common/card.css';

.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .scroll-inner { padding: 0 4px 16px 4px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .scroll-inner { padding: 0 4px 16px 4px; }
}
</style>
