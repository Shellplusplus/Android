<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ $t("detail.title") }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>
      <div class="scroll-inner">

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.status") }}</text>
            <text class="card-sub {{ luaConnected ? 'text-green' : 'text-red' }}">{{ luaConnected ? $t("detail.connected") : $t("detail.disconnected") }}</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.lastSync") }}</text>
            <text class="card-sub">{{ lastHeartbeat || $t("detail.none") }}</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.dataDir") }}</text>
            <text class="card-sub">/data/quickapp/files/com.shell.liangyi/</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("detail.luaBackend") }}</text>
            <text class="card-sub">{{ luaConnected ? $t("detail.running") : $t("detail.stopped") }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

var SYSINFO_FILE = "internal://files/system_info.json"

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    refreshTimer: null,
    luaConnected: false,
    lastHeartbeat: ""
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
  },

  onShow() {
    var self = this
    self.refresh()
    if (!self.refreshTimer) {
      self.refreshTimer = setInterval(function() { self.refresh() }, 2000)
    }
  },

  onHide() {
    if (this.refreshTimer) {
      clearInterval(this.refreshTimer)
      this.refreshTimer = null
    }
  },

  onDestroy() {
    clearInterval(this.timer)
    if (this.refreshTimer) {
      clearInterval(this.refreshTimer)
    }
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  refresh() {
    var self = this
    file.readText({
      uri: SYSINFO_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          if (json._init) {
            self.luaConnected = false
            self.lastHeartbeat = ""
            return
          }
          if (json.timestamp) {
            var now = Math.floor(Date.now() / 1000)
            var ts = parseInt(json.timestamp)
            if (isNaN(ts)) {
              self.luaConnected = false
              self.lastHeartbeat = ""
              return
            }
            if (now - ts > 15) {
              self.luaConnected = false
              self.lastHeartbeat = json.timestamp + " (超时)"
              return
            }
          }
          /* Unix 时间戳转为可读格式 */
          self.luaConnected = true
          var ht = parseInt(json.timestamp)
          if (!isNaN(ht)) {
            var d = new Date(ht * 1000)
            self.lastHeartbeat = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) + ":" + ("0" + d.getSeconds()).slice(-2)
          } else {
            self.lastHeartbeat = json.timestamp || "未知"
          }
        } catch(e) {
          /* 心跳文件损坏或格式异常 */
          self.luaConnected = false
          self.lastHeartbeat = ""
        }
      },
      fail: function() {
        self.luaConnected = false
        self.lastHeartbeat = ""
      }
    })
  },

  goBack() { router.back() }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000000; }
.content-full { width: 336px; height: 480px; flex-direction: column; }
.header-area { width: 336px; height: 102px; position: relative; }
.header-bg { width: 336px; height: 102px; }
.hd-time { position: absolute; left: 78px; top: 7px; width: 180px; height: 32px; text-align: center; font-size: 24px; font-weight: bold; color: rgba(255,255,255,0.6); }
.hd-title { position: absolute; left: 78px; top: 35px; width: 180px; height: 42px; text-align: center; font-size: 32px; font-weight: bold; color: #ffffff; }
.hd-back { position: absolute; left: 6px; top: 6px; width: 72px; height: 72px; }
.pill-header { display: none; }
@import '../../common/card.css';
.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }
.text-green { color: #00ff00; }
.text-red { color: #ff3333; }

/* 336x480 rect screen offset */
@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .page { width: 192px; height: 490px; }
  .content-full { width: 192px; height: 490px; }
  .header-area { display: none; }
  .hd-title { width: 192px; top: 22px; font-size: 22px; }
  .hd-back { left: 4px; top: 4px; width: 52px; height: 52px; }
  .pill-header { display: flex; width: 192px; height: 92px; flex-direction: column; align-items: center; justify-content: flex-start; }
  .pill-more-wrap { width: 92px; height: 72px; border-radius: 32px; flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
  .pill-more { width: 92px; height: 72px; background-image: url(/common/back_capsule.png); background-size: 92px 72px; border-radius: 32px; }
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 176px; height: 110px; border-radius: 27px; padding-left: 20px; padding-right: 12px; }
  .card-label { font-size: 32px; line-height: 38px; }
  .card-sub { font-size: 28px; line-height: 34px; margin-top: 9px; }
  .spacer { height: 16px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .page { width: 212px; height: 520px; }
  .content-full { width: 212px; height: 520px; }
  .header-area { display: none; }
  .hd-title { width: 212px; top: 22px; font-size: 22px; }
  .hd-back { left: 4px; top: 4px; width: 52px; height: 52px; }
  .pill-header { display: flex; width: 212px; height: 92px; flex-direction: column; align-items: center; justify-content: flex-start; }
  .pill-more-wrap { width: 102px; height: 72px; border-radius: 36px; flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
  .pill-more { width: 102px; height: 72px; background-image: url(/common/back_capsule.png); background-size: 102px 72px; border-radius: 36px; }
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 196px; height: 110px; border-radius: 27px; padding-left: 20px; padding-right: 12px; }
  .card-label { font-size: 32px; line-height: 38px; }
  .card-sub { font-size: 28px; line-height: 34px; margin-top: 9px; }
  .spacer { height: 16px; }
}
</style>
