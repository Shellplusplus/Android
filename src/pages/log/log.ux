<template>
  <div class="page">
    <scroll id="scrollId" class="content-full" scroll-y="true" bounces="true" onclick="onTxtClick">
      <div show="{{showToolbar}}" class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ logTitle }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div show="{{showToolbar}}" class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <div class="text-container">
        <text class="log-text">{{ logText }}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

export default {
  protected: { content: "", title: "" },

  private: {
    nowTime: "00:00",
    timer: null,
    logText: "",
    logTitle: "",
    showToolbar: true
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
    self.logTitle = self.title || self.$t("log.title")
    /* 优先从文件读取完整输出，其次从路由参数 */
    if (this.content) {
      self.logText = this.content
    } else {
      file.readText({
        uri: "internal://files/full_output.txt",
        success: function(data) {
          if (data.text) {
            self.logText = data.text
          } else {
            self.logText = self.$t("log.empty")
          }
        },
        fail: function() {
          self.logText = self.$t("log.empty")
        }
      })
    }
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  onTxtClick() {
    this.showToolbar = !this.showToolbar
  },

  goBack() { router.back() }
}
</script>

<style>
@import '../../common/back-page.css';

.text-container { margin-top: 0; padding: 6px 16px 20px 16px; width: 336px; flex-direction: column; }
.log-text { width: 304px; font-size: 28px; line-height: 36px; text-align: left; color: #ffffff; font-weight: bold; word-break: break-all; }
@media (shape: rect) {
  .text-container { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .text-container { padding: 6px 10px 20px 10px; width: 192px; }
  .log-text { width: 172px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .text-container { padding: 6px 10px 20px 10px; width: 212px; }
  .log-text { width: 192px; }
}
</style>
