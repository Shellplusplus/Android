<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ $t("settings.title") }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <div class="scroll-inner">

        <div class="card" onclick="goFavorites">
          <div class="card-left">
            <text class="card-label">{{ $t("settings.favorites") }}</text>
            <text class="card-sub">{{ $t("settings.favoritesDesc") }}</text>
          </div>
        </div>

        <div class="card" onclick="toggleHistoryLimit">
          <div class="card-left">
            <text class="card-label">{{ $t("settings.historyLimit") }}</text>
            <text class="card-sub">{{ historyLimitText }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

var HISTORY_CONFIG_FILE = "internal://files/history_config.json"

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    historyLimit: 5,
    historyLimitText: ""
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
    self.loadHistoryLimit()
  },

  onShow() {
    this.loadHistoryLimit()
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  normalizeHistoryLimit(limit) {
    return this.$app.$def.shellData.normalizeHistoryLimit(limit)
  },

  updateHistoryLimitText() {
    this.historyLimitText = this.$t("settings.historyLimitDescPrefix") + this.historyLimit + this.$t("settings.historyLimitDescSuffix")
  },

  loadHistoryLimit() {
    var self = this
    file.readText({
      uri: HISTORY_CONFIG_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          self.historyLimit = self.normalizeHistoryLimit(json.limit)
        } catch(e) {
          self.historyLimit = self.$app.$def.shellData.defaultHistoryLimit
        }
        self.updateHistoryLimitText()
      },
      fail: function() {
        self.historyLimit = self.$app.$def.shellData.defaultHistoryLimit
        self.updateHistoryLimitText()
      }
    })
  },

  writeHistoryLimit(limit) {
    var self = this
    file.writeText({
      uri: HISTORY_CONFIG_FILE,
      text: JSON.stringify({ limit: limit }),
      append: false,
      success: function() {
        self.historyLimit = limit
        self.updateHistoryLimitText()
      }
    })
  },

  toggleHistoryLimit() {
    var options = this.$app.$def.shellData.historyLimitOptions
    var currentIndex = 0
    for (var i = 0; i < options.length; i++) {
      if (options[i] === this.historyLimit) {
        currentIndex = i
        break
      }
    }
    var nextIndex = (currentIndex + 1) % options.length
    this.writeHistoryLimit(options[nextIndex])
  },

  goFavorites() {
    router.push({ uri: "/pages/favorites" })
  },

  goBack() { router.back() }
}
</script>

<style>
@import '../../common/back-page.css';
@import '../../common/card.css';

.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .scroll-inner { padding: 0 4px 16px 4px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .scroll-inner { padding: 0 4px 16px 4px; }
}
</style>
