<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ $t("screenshot.title") }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <div class="scroll-inner">
        <div class="card card-primary" onclick="requestScreenshot">
          <div class="card-left">
            <text class="card-label">{{ $t("screenshot.startTitle") }}</text>
            <text class="card-sub card-sub-primary">{{ isBusy ? $t("screenshot.busyDesc") : $t("screenshot.startDesc") }}</text>
          </div>
        </div>

        <div class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("screenshot.statusTitle") }}</text>
            <text class="card-sub status-sub">{{ statusText }}</text>
          </div>
        </div>

        <div if="{{hasPreview}}" class="preview-card">
          <image class="preview-image" style="{{ previewImageStyle }}" src="{{ previewPath }}"></image>
          <text class="preview-title">{{ previewIndex }}</text>
          <text class="preview-sub">{{ previewTime }}</text>
          <div if="{{previewMode !== 'sample' || previewDeleteButtonEnabled}}" class="preview-actions">
            <text class="delete-btn" onclick="deleteCurrentShot">{{ $t("screenshot.delete") }}</text>
          </div>
        </div>

        <div if="{{showHistoryDivider}}" class="history-divider"></div>

        <div if="{{!hasPreview}}" class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("screenshot.emptyTitle") }}</text>
            <text class="card-sub">{{ $t("screenshot.emptyDesc") }}</text>
          </div>
        </div>

        <div if="{{hasShots}}" class="card" for="{{shotItems}}" tid="id" onclick="onShotItemClick($item)">
          <div class="card-left">
            <text class="card-label">{{ $item.label }}</text>
            <text class="card-sub">{{ $item.timeText }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"
import prompt from "@system.prompt"
import device from "@system.device"

var REQUEST_FILE = "internal://files/screenshot_request.json"
var RESULT_FILE = "internal://files/screenshot_result.json"
var HISTORY_FILE = "internal://files/screenshot_history.json"
var BRIDGE_STATE_FILE = "internal://files/bridge_state.json"
var QUICKAPP_DEBUG_FILE = "internal://files/quickapp_debug.json"
var PREVIEW_STATE_FILE = "internal://files/screenshot_preview_state.json"
var shotSeq = Date.now()

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    pollTimer: null,
    previewTimer: null,
    statusText: "",
    isBusy: false,
    hasPreview: false,
    previewPath: "",
    previewIndex: 0,
    previewTime: "",
    previewMode: "real",
    hasShots: false,
    showHistoryDivider: false,
    shotItems: [],
    followLatest: true,
    selectedPreviewFile: "",
    selectedPreviewId: "",
    quickAppDebugEnabled: false,
    previewDeleteButtonEnabled: false,
    previewHistoryEnabled: false,
    samplePath: "",
    sampleLabel: "",
    previewImageStyle: "height: 180px;",
    screenWidth: 336,
    screenHeight: 480
  },

  onInit() {
    var self = this
    self.updateTime()
    self.statusText = self.$t("screenshot.idle")
    self.timer = setInterval(function() { self.updateTime() }, 1000)
    self.resolveSamplePath()
    self.loadPreviewState()
  },

  onShow() {
    var self = this
    self.loadPreviewState()
    self.refreshAll()
    self.loadQuickAppDebugMode()
    if (!self.pollTimer) {
      self.pollTimer = setInterval(function() {
        self.refreshAll()
        self.loadQuickAppDebugMode()
      }, 1000)
    }
  },

  onHide() {
    if (this.pollTimer) {
      clearInterval(this.pollTimer)
      this.pollTimer = null
    }
  },

  onDestroy() {
    clearInterval(this.timer)
    if (this.pollTimer) {
      clearInterval(this.pollTimer)
    }
    if (this.previewTimer) {
      clearTimeout(this.previewTimer)
      this.previewTimer = null
    }
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  refreshAll() {
    this.loadState()
    this.loadHistory()
  },

  loadPreviewState() {
    var self = this
    file.readText({
      uri: PREVIEW_STATE_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          self.previewMode = json.mode === "sample" ? "sample" : "real"
          self.followLatest = json.followLatest !== false
          self.selectedPreviewFile = json.selectedFile || ""
          self.selectedPreviewId = json.selectedId || ""
        } catch (e) {
          self.previewMode = "real"
          self.followLatest = true
          self.selectedPreviewFile = ""
          self.selectedPreviewId = ""
        }
        self.applyPreviewMode()
        self.loadHistory()
      },
      fail: function() {
        self.previewMode = "real"
        self.followLatest = true
        self.selectedPreviewFile = ""
        self.selectedPreviewId = ""
        self.applyPreviewMode()
        self.loadHistory()
      }
    })
  },

  writePreviewState(mode, followLatest, selectedFile, selectedId) {
    file.writeText({
      uri: PREVIEW_STATE_FILE,
      text: JSON.stringify({
        mode: mode,
        followLatest: followLatest !== false,
        selectedFile: selectedFile || "",
        selectedId: selectedId || ""
      }),
      append: false
    })
  },

  applyPreviewMode() {
    if (this.previewMode !== "sample" || !this.samplePath) {
      return
    }
    this.followLatest = false
    this.selectedPreviewFile = ""
    this.selectedPreviewId = ""
    this.renderPreview(
      this.samplePath,
      this.$t("screenshot.sampleIndex"),
      this.$t("screenshot.sampleTimePrefix") + this.sampleLabel
    )
  },

  resolveSamplePath() {
    var self = this
    device.getInfo({
      success: function(ret) {
        var width = ret.screenWidth || 336
        var height = ret.screenHeight || 480
        self.screenWidth = width
        self.screenHeight = height
        if (width <= 192) {
          self.samplePath = "/common/Debug_192.png"
          self.sampleLabel = "192"
        } else if (width <= 212) {
          self.samplePath = "/common/Debug_212.png"
          self.sampleLabel = "212"
        } else {
          self.samplePath = "/common/Debug_336.png"
          self.sampleLabel = "336"
        }
        self.updatePreviewImageStyle()
      },
      fail: function() {
        self.screenWidth = 336
        self.screenHeight = 480
        self.samplePath = "/common/Debug_336.png"
        self.sampleLabel = "336"
        self.updatePreviewImageStyle()
      }
    })
  },

  updatePreviewImageStyle() {
    var width = 300
    if (this.screenWidth <= 192) {
      width = 164
    } else if (this.screenWidth <= 212) {
      width = 184
    }
    var ratio = this.screenHeight / this.screenWidth
    var height = Math.round(width * ratio)
    this.previewImageStyle = "height: " + height + "px;"
  },

  loadQuickAppDebugMode() {
    var self = this
    file.readText({
      uri: QUICKAPP_DEBUG_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          self.quickAppDebugEnabled = json.enabled === true
          self.previewDeleteButtonEnabled = json.showDeleteButton === true
          self.previewHistoryEnabled = json.showHistorySample === true
        } catch (e) {
          self.quickAppDebugEnabled = false
          self.previewDeleteButtonEnabled = false
          self.previewHistoryEnabled = false
        }
        if (!self.quickAppDebugEnabled && self.previewMode === "sample") {
          self.resetPreview()
        }
        self.loadHistory()
      },
      fail: function() {
        self.quickAppDebugEnabled = false
        self.previewDeleteButtonEnabled = false
        self.previewHistoryEnabled = false
        if (self.previewMode === "sample") {
          self.resetPreview()
        }
        self.loadHistory()
      }
    })
  },

  loadState() {
    var self = this
    file.readText({
      uri: BRIDGE_STATE_FILE,
      success: function(data) {
        try {
          var state = JSON.parse(data.text)
          self.isBusy = state.busy === true
          if (self.isBusy) {
            if (state.mode === "screenshot" && state.message) {
              self.statusText = state.message
            } else {
              self.statusText = self.$t("screenshot.bridgeBusy")
            }
            return
          }
          self.loadResultState()
        } catch (e) {
          self.isBusy = false
          self.loadResultState()
        }
      },
      fail: function() {
        self.isBusy = false
        self.loadResultState()
      }
    })
  },

  loadResultState() {
    var self = this
    file.readText({
      uri: RESULT_FILE,
      success: function(data) {
        try {
          var result = JSON.parse(data.text)
          if (result.status === "done") {
            self.statusText = self.$t("screenshot.done")
          } else if (result.status === "error") {
            self.statusText = result.message || self.$t("screenshot.error")
          } else if (result.status === "waiting_screen_on" || result.status === "capturing") {
            self.statusText = result.message || self.$t("screenshot.preparing")
          } else {
            self.statusText = self.$t("screenshot.idle")
          }
        } catch (e) {
          self.statusText = self.$t("screenshot.idle")
        }
      },
      fail: function() {
        self.statusText = self.$t("screenshot.idle")
      }
    })
  },

  normalizeShots(items) {
    var normalized = []
    var seenIds = {}
    if (!(items instanceof Array)) return normalized
    for (var i = 0; i < items.length; i++) {
      var item = items[i]
      if (!item || !item.file) continue
      var shotId = item.shotId || this.buildShotId(item, i + 1)
      if (seenIds[shotId]) continue
      seenIds[shotId] = true
      var filePath = this.buildShotFilePath(shotId, item.file)
      normalized.push({
        id: "shot-" + shotId,
        type: "real",
        label: shotId,
        shotId: shotId,
        index: item.index || (i + 1),
        file: filePath,
        timeText: item.capturedAt || this.$t("screenshot.unknownTime"),
        capturedAtUnix: item.capturedAtUnix || 0
      })
    }
    normalized.sort(function(a, b) {
      if (b.index !== a.index) {
        return b.index - a.index
      }
      return (b.capturedAtUnix || 0) - (a.capturedAtUnix || 0)
    })
    return normalized
  },

  buildShotId(item, fallbackIndex) {
    if (item && item.shotId) {
      return item.shotId
    }
    var raw = item && item.capturedAt ? item.capturedAt : ""
    var timePart = raw ? raw.replace(/[-:\s]/g, "") : ""
    if (!timePart) {
      timePart = "00000000000000"
    }
    return timePart + "#" + (item && item.index ? item.index : fallbackIndex)
  },

  buildShotFilePath(shotId, fallbackFile) {
    if (shotId) {
      return "internal://files/screenshots/" + shotId.replace("#", "_") + ".png"
    }
    return fallbackFile || ""
  },

  buildDebugHistoryItems() {
    if (!this.quickAppDebugEnabled || !this.previewHistoryEnabled || !this.samplePath) {
      return []
    }
    return [
      {
        id: "shot-debug-history-1",
        type: "debug",
        label: "20260616002803#1",
        shotId: "20260616002803#1",
        index: 1,
        file: this.samplePath,
        timeText: "2026-06-16 00:28:03",
        capturedAtUnix: 1781540883
      },
      {
        id: "shot-debug-history-2",
        type: "debug",
        label: "20260616002815#2",
        shotId: "20260616002815#2",
        index: 2,
        file: this.samplePath,
        timeText: "2026-06-16 00:28:15",
        capturedAtUnix: 1781540895
      }
    ]
  },

  renderPreview(path, indexText, timeText) {
    var self = this
    var nextPath = path || ""
    var nextIndex = indexText || ""
    var nextTime = timeText || ""
    var needReload = self.previewPath !== nextPath
    if (self.previewTimer) {
      clearTimeout(self.previewTimer)
      self.previewTimer = null
    }
    if (!needReload) {
      self.previewPath = nextPath
      self.previewIndex = nextIndex
      self.previewTime = nextTime
      self.hasPreview = !!nextPath
      return
    }
    self.hasPreview = false
    self.previewPath = ""
    self.previewTimer = setTimeout(function() {
      self.previewPath = nextPath
      self.previewIndex = nextIndex
      self.previewTime = nextTime
      self.hasPreview = !!nextPath
      self.previewTimer = null
    }, 30)
  },

  loadHistory() {
    var self = this
    file.readText({
      uri: HISTORY_FILE,
      success: function(data) {
        var list = []
        try {
          list = JSON.parse(data.text)
          if (list && list.items instanceof Array) {
            list = list.items
          }
        } catch (e) {}
        var realItems = self.normalizeShots(list)
        var debugItems = self.buildDebugHistoryItems()
        for (var j = 0; j < debugItems.length; j++) {
          realItems.push(debugItems[j])
        }
        if (self.previewMode === "sample") {
          self.shotItems = self.buildShotItems(realItems)
          self.hasShots = self.shotItems.length > 0
          self.showHistoryDivider = self.hasShots
          self.applyPreviewMode()
          return
        }
        if (realItems.length > 0) {
          var latest = realItems[0]
          var previewItem = latest
          if (!self.followLatest && (self.selectedPreviewId || self.selectedPreviewFile)) {
            for (var i = 0; i < realItems.length; i++) {
              if (
                (self.selectedPreviewId && realItems[i].shotId === self.selectedPreviewId) ||
                (!self.selectedPreviewId && realItems[i].file === self.selectedPreviewFile)
              ) {
                previewItem = realItems[i]
                break
              }
            }
          }
          self.renderPreview(previewItem.file, previewItem.shotId, previewItem.timeText)
          self.shotItems = self.buildShotItems(realItems, previewItem.shotId)
          self.hasShots = self.shotItems.length > 0
          self.showHistoryDivider = self.hasShots
        } else {
          self.renderPreview("", "", "")
          self.shotItems = self.buildShotItems([])
          self.hasShots = false
          self.showHistoryDivider = false
        }
      },
      fail: function() {
        self.shotItems = self.buildShotItems([])
        self.hasShots = self.shotItems.length > 0
        if (self.previewMode === "sample") {
          var debugItems = self.buildDebugHistoryItems()
          if (debugItems.length > 0) {
            self.shotItems = self.buildShotItems(debugItems)
            self.hasShots = self.shotItems.length > 0
            self.showHistoryDivider = self.hasShots
          }
          self.applyPreviewMode()
          return
        }
        self.renderPreview("", "", "")
        self.showHistoryDivider = false
      }
    })
  },

  buildShotItems(realItems, excludeShotId) {
    if (!excludeShotId) {
      return realItems.slice(0)
    }
    var items = []
    for (var i = 0; i < realItems.length; i++) {
      if (realItems[i].shotId !== excludeShotId) {
        items.push(realItems[i])
      }
    }
    return items
  },

  requestScreenshot() {
    var self = this
    if (self.isBusy) {
      prompt.showToast({ message: self.statusText || self.$t("screenshot.busyDesc") })
      return
    }
    shotSeq++
    self.followLatest = true
    self.selectedPreviewFile = ""
    self.selectedPreviewId = ""
    self.writePreviewState("real", true, "", "")
    file.writeText({
      uri: REQUEST_FILE,
      text: JSON.stringify({
        seq: shotSeq,
        type: "screenshot",
        timestamp: Math.floor(Date.now() / 1000)
      }),
      append: false,
      success: function() {
        self.isBusy = true
        self.statusText = self.$t("screenshot.preparing")
      },
      fail: function() {
        self.statusText = self.$t("screenshot.error")
        prompt.showToast({ message: self.$t("screenshot.error") })
      }
    })
  },

  selectShot(item) {
    if (!item) return
    this.previewMode = "real"
    this.followLatest = false
    this.selectedPreviewFile = item.file || ""
    this.selectedPreviewId = item.shotId || ""
    this.writePreviewState("real", false, this.selectedPreviewFile, this.selectedPreviewId)
    this.renderPreview(item.file || "", item.shotId || "", item.timeText || "")
  },

  onShotItemClick(item) {
    if (!item) return
    this.selectShot(item)
  },

  deleteCurrentShot() {
    var self = this
    if (!self.previewPath) {
      return
    }
    if (self.previewMode === "sample") {
      return
    }
    if (self.isBusy) {
      prompt.showToast({ message: self.statusText || self.$t("screenshot.busyDesc") })
      return
    }
    var targetFile = self.previewPath
    var targetShotId = self.previewIndex
    file.readText({
      uri: HISTORY_FILE,
      success: function(data) {
        var store = []
        try {
          store = JSON.parse(data.text)
        } catch (e) {}
        self.removeScreenshotFile(targetFile, function() {
          self.writeHistoryAfterDelete(store, targetFile, targetShotId)
        })
      },
      fail: function() {
        self.removeScreenshotFile(targetFile, function() {
          self.writeHistoryAfterDelete([], targetFile, targetShotId)
        })
      }
    })
  },

  removeScreenshotFile(filePath, done) {
    file.delete({
      uri: filePath,
      success: function() {
        done()
      },
      fail: function() {
        done()
      }
    })
  },

  writeHistoryAfterDelete(store, targetFile, targetShotId) {
    var self = this
    var items = store
    if (store && store.items instanceof Array) {
      items = store.items
    }
    if (!(items instanceof Array)) {
      items = []
    }
    var filtered = []
    for (var i = 0; i < items.length; i++) {
      var item = items[i]
      if (!item || !item.file) continue
      if (item.shotId && targetShotId && item.shotId === targetShotId) continue
      if (item.file === targetFile) continue
        filtered.push(items[i])
    }
    var payload = filtered
    if (store && store.items instanceof Array) {
      payload = {
        items: filtered,
        nextIndex: store.nextIndex || 1,
        lastItem: filtered.length > 0 ? filtered[0] : null
      }
    }
    file.writeText({
      uri: HISTORY_FILE,
      text: JSON.stringify(payload),
      append: false,
      success: function() {
        self.followLatest = true
        self.selectedPreviewFile = ""
        self.selectedPreviewId = ""
        self.writePreviewState("real", true, "", "")
        self.refreshAll()
        prompt.showToast({ message: self.$t("screenshot.deleteDone") })
      },
      fail: function() {
        prompt.showToast({ message: self.$t("screenshot.deleteFail") })
      }
    })
  },

  resetPreview() {
    this.previewMode = "real"
    this.followLatest = true
    this.selectedPreviewFile = ""
    this.selectedPreviewId = ""
    this.writePreviewState("real", true, "", "")
    if (this.shotItems.length > 0) {
      var latest = this.shotItems[0]
      this.renderPreview(latest.file, latest.shotId, latest.timeText)
    } else {
      this.renderPreview("", "", "")
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/back-page.css';
@import '../../common/card.css';

.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }
.status-sub { lines: 2; }
.preview-card {
  width: 324px;
  margin: 8px 6px 0 6px;
  padding: 12px;
  border-radius: 36px;
  background-color: #262626;
  flex-direction: column;
}
.preview-image {
  width: 300px;
  height: 180px;
  border-radius: 24px;
  background-color: #111111;
  object-fit: contain;
}
.preview-title {
  margin-top: 12px;
  font-size: 28px;
  line-height: 34px;
  font-weight: bold;
  color: #ffffff;
}
.preview-sub {
  margin-top: 4px;
  font-size: 24px;
  line-height: 30px;
  color: rgba(255,255,255,0.6);
  font-weight: bold;
}
.preview-actions {
  width: 300px;
  margin-top: 12px;
  flex-direction: row;
  justify-content: flex-end;
}
.history-divider {
  width: 300px;
  height: 2px;
  margin: 12px 18px 4px 18px;
  background-color: rgba(255,255,255,0.14);
  border-radius: 1px;
}
.delete-btn {
  width: 60px;
  height: 36px;
  border-radius: 18px;
  background-color: #D93A2F;
  text-align: center;
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
  line-height: 36px;
}

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}

@media (shape: pill-shaped) and (max-width: 100) {
  .preview-card {
    width: 184px;
    margin: 8px 4px 0 4px;
    padding: 10px;
    border-radius: 27px;
  }
  .preview-image {
    width: 164px;
    height: 98px;
    border-radius: 20px;
  }
  .preview-title {
    font-size: 24px;
    line-height: 30px;
  }
  .preview-sub {
    font-size: 20px;
    line-height: 24px;
  }
  .preview-actions {
    width: 164px;
  }
  .history-divider {
    width: 164px;
    margin: 12px 14px 4px 14px;
  }
  .delete-btn {
    width: 52px;
    font-size: 20px;
  }
}

@media (shape: pill-shaped) and (min-width: 101) {
  .preview-card {
    width: 204px;
    margin: 8px 4px 0 4px;
    padding: 10px;
    border-radius: 27px;
  }
  .preview-image {
    width: 184px;
    height: 110px;
    border-radius: 20px;
  }
  .preview-title {
    font-size: 24px;
    line-height: 30px;
  }
  .preview-sub {
    font-size: 20px;
    line-height: 24px;
  }
  .preview-actions {
    width: 184px;
  }
  .history-divider {
    width: 184px;
    margin: 12px 14px 4px 14px;
  }
}
</style>
