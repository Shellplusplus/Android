<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ $t("debug.title") }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <div class="scroll-inner">
        <text class="section-title">{{ $t("debug.modeGroup") }}</text>
        <div class="card" onclick="toggleSystemDebug">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.systemTitle") }}</text>
            <text class="card-sub">{{ systemDebugText }}</text>
          </div>
        </div>

        <div class="card" onclick="onQuickAppDebug">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.quickAppTitle") }}</text>
            <text class="card-sub">{{ quickAppDebugText }}</text>
          </div>
        </div>

        <text class="section-title">{{ $t("debug.screenshotGroup") }}</text>
        <div class="card" onclick="showSamplePreview">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.previewSampleTitle") }}</text>
            <text class="card-sub">{{ $t("debug.previewSampleDesc") }}</text>
          </div>
        </div>

        <div class="card" onclick="togglePreviewHistorySample">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.previewHistoryTitle") }}</text>
            <text class="card-sub">{{ previewHistoryText }}</text>
          </div>
        </div>

        <div class="card" onclick="togglePreviewDeleteButton">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.previewDeleteTitle") }}</text>
            <text class="card-sub">{{ previewDeleteButtonText }}</text>
          </div>
        </div>

        <div class="card" onclick="resetScreenshotPreview">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.previewResetTitle") }}</text>
            <text class="card-sub">{{ $t("debug.previewResetDesc") }}</text>
          </div>
        </div>

        <div class="card" onclick="clearAllScreenshots">
          <div class="card-left">
            <text class="card-label">{{ $t("debug.clearShotsTitle") }}</text>
            <text class="card-sub">{{ $t("debug.clearShotsDesc") }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"
import prompt from "@system.prompt"

var DEBUG_FILE = "internal://files/debug_mode.json"
var QUICKAPP_DEBUG_FILE = "internal://files/quickapp_debug.json"
var PREVIEW_STATE_FILE = "internal://files/screenshot_preview_state.json"
var HISTORY_FILE = "internal://files/screenshot_history.json"

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    debugEnabled: false,
    quickAppDebugEnabled: false,
    previewDeleteButtonEnabled: false,
    previewHistoryEnabled: false,
    systemDebugText: "",
    quickAppDebugText: "",
    previewDeleteButtonText: "",
    previewHistoryText: "",
    pendingEnable: false
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
    self.loadDebugMode()
    self.loadQuickAppDebugMode()
  },

  onShow() {
    if (this.pendingEnable) {
      this.pendingEnable = false
      this.writeDebugMode(true)
      return
    }
    this.loadDebugMode()
    this.loadQuickAppDebugMode()
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  updateSystemDebugText() {
    this.systemDebugText = this.debugEnabled ? this.$t("debug.systemOn") : this.$t("debug.systemOff")
  },

  updateQuickAppDebugText() {
    this.quickAppDebugText = this.quickAppDebugEnabled ? this.$t("debug.quickAppOn") : this.$t("debug.quickAppOff")
  },

  updatePreviewDeleteButtonText() {
    this.previewDeleteButtonText = this.previewDeleteButtonEnabled
      ? this.$t("debug.previewDeleteOn")
      : this.$t("debug.previewDeleteOff")
  },

  updatePreviewHistoryText() {
    this.previewHistoryText = this.previewHistoryEnabled
      ? this.$t("debug.previewHistoryOn")
      : this.$t("debug.previewHistoryOff")
  },

  loadDebugMode() {
    var self = this
    file.readText({
      uri: DEBUG_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          self.debugEnabled = json.enabled === true
        } catch (e) {
          self.debugEnabled = false
        }
        self.updateSystemDebugText()
      },
      fail: function() {
        self.debugEnabled = false
        self.updateSystemDebugText()
      }
    })
  },

  loadQuickAppDebugMode() {
    var self = this
    file.readText({
      uri: QUICKAPP_DEBUG_FILE,
      success: function(data) {
        try {
          var json = JSON.parse(data.text)
          self.quickAppDebugEnabled = json.enabled === true
          self.previewDeleteButtonEnabled = json.showDeleteButton === true
          self.previewHistoryEnabled = json.showHistorySample === true
        } catch (e) {
          self.quickAppDebugEnabled = false
          self.previewDeleteButtonEnabled = false
          self.previewHistoryEnabled = false
        }
        self.updateQuickAppDebugText()
        self.updatePreviewDeleteButtonText()
        self.updatePreviewHistoryText()
      },
      fail: function() {
        self.quickAppDebugEnabled = false
        self.previewDeleteButtonEnabled = false
        self.previewHistoryEnabled = false
        self.updateQuickAppDebugText()
        self.updatePreviewDeleteButtonText()
        self.updatePreviewHistoryText()
      }
    })
  },

  writeDebugMode(enabled) {
    var self = this
    file.writeText({
      uri: DEBUG_FILE,
      text: JSON.stringify({ enabled: enabled }),
      append: false,
      success: function() {
        self.debugEnabled = enabled
        self.updateSystemDebugText()
        prompt.showToast({
          message: enabled ? self.$t("index.debugEnabledToast") : self.$t("index.debugDisabledToast")
        })
      }
    })
  },

  writeQuickAppDebugMode(enabled, showDeleteButton, showHistorySample) {
    var self = this
    file.writeText({
      uri: QUICKAPP_DEBUG_FILE,
      text: JSON.stringify({
        enabled: enabled,
        showDeleteButton: showDeleteButton === true,
        showHistorySample: showHistorySample === true
      }),
      append: false,
      success: function() {
        self.quickAppDebugEnabled = enabled
        self.previewDeleteButtonEnabled = showDeleteButton === true
        self.previewHistoryEnabled = showHistorySample === true
        self.updateQuickAppDebugText()
        self.updatePreviewDeleteButtonText()
        self.updatePreviewHistoryText()
        prompt.showToast({
          message: enabled ? self.$t("debug.quickAppEnabledToast") : self.$t("debug.quickAppDisabledToast")
        })
      }
    })
  },

  toggleSystemDebug() {
    var self = this
    if (self.debugEnabled) {
      self.writeDebugMode(false)
      return
    }
    self.pendingEnable = true
    router.push({
      uri: "/pages/log",
      params: {
        content: self.$t("settings.disclaimer"),
        title: self.$t("settings.disclaimerTitle")
      }
    })
  },

  onQuickAppDebug() {
    var enabled = !this.quickAppDebugEnabled
    this.writeQuickAppDebugMode(
      enabled,
      enabled ? this.previewDeleteButtonEnabled : false,
      enabled ? this.previewHistoryEnabled : false
    )
  },

  togglePreviewDeleteButton() {
    if (!this.quickAppDebugEnabled) {
      return
    }
    this.writeQuickAppDebugMode(true, !this.previewDeleteButtonEnabled, this.previewHistoryEnabled)
  },

  togglePreviewHistorySample() {
    if (!this.quickAppDebugEnabled) {
      return
    }
    this.writeQuickAppDebugMode(true, this.previewDeleteButtonEnabled, !this.previewHistoryEnabled)
  },

  showSamplePreview() {
    var self = this
    if (!self.quickAppDebugEnabled) {
      prompt.showToast({
        message: self.$t("debug.quickAppOff")
      })
      return
    }
    file.writeText({
      uri: PREVIEW_STATE_FILE,
      text: JSON.stringify({ mode: "sample" }),
      append: false,
      success: function() {
        prompt.showToast({
          message: self.$t("debug.previewSampleToast")
        })
      }
    })
  },

  resetScreenshotPreview() {
    var self = this
    file.writeText({
      uri: PREVIEW_STATE_FILE,
      text: JSON.stringify({ mode: "real" }),
      append: false,
      success: function() {
        prompt.showToast({
          message: self.$t("debug.previewResetToast")
        })
      }
    })
  },

  clearAllScreenshots() {
    var self = this
    file.readText({
      uri: HISTORY_FILE,
      success: function(data) {
        var store = {}
        var items = []
        try {
          store = JSON.parse(data.text)
          items = store && store.items instanceof Array ? store.items : (store instanceof Array ? store : [])
        } catch (e) {}
        self.deleteScreenshotFiles(items, 0, function() {
          self.writeEmptyScreenshotHistory()
        })
      },
      fail: function() {
        self.writeEmptyScreenshotHistory()
      }
    })
  },

  deleteScreenshotFiles(items, index, done) {
    var self = this
    if (!(items instanceof Array) || index >= items.length) {
      done()
      return
    }
    var item = items[index]
    var next = function() {
      self.deleteScreenshotFiles(items, index + 1, done)
    }
    if (!item || !item.file) {
      next()
      return
    }
    file.delete({
      uri: item.file,
      success: function() {
        next()
      },
      fail: function() {
        next()
      }
    })
  },

  writeEmptyScreenshotHistory() {
    var self = this
    file.writeText({
      uri: HISTORY_FILE,
      text: JSON.stringify({
        items: [],
        nextIndex: 1,
        lastItem: null
      }),
      append: false,
      success: function() {
        prompt.showToast({
          message: self.$t("debug.clearShotsDone")
        })
      },
      fail: function() {
        prompt.showToast({
          message: self.$t("debug.clearShotsFail")
        })
      }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/back-page.css';
@import '../../common/card.css';

.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }
.section-title {
  width: 324px;
  margin: 12px 6px 0 12px;
  font-size: 22px;
  line-height: 28px;
  color: rgba(255,255,255,0.55);
  font-weight: bold;
}

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .scroll-inner { padding: 0 4px 16px 4px; }
  .section-title {
    width: 184px;
    margin: 12px 4px 0 8px;
    font-size: 18px;
    line-height: 22px;
  }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .scroll-inner { padding: 0 4px 16px 4px; }
  .section-title {
    width: 204px;
    margin: 12px 4px 0 8px;
    font-size: 18px;
    line-height: 22px;
  }
}
</style>
