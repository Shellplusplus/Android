<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ $t("favorites.manageTitle") }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>

      <div class="scroll-inner">
        <div class="card {{ $item.cardClass }}" for="{{cmds}}" tid="id" onclick="toggleFavorite($item.cmd)">
          <div class="card-left">
            <text class="card-label {{ $item.labelClass }}">{{ $item.label }}</text>
            <text class="card-sub {{ $item.subClass }}">{{ $item.desc }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

var FAVORITES_FILE = "internal://files/favorites.json"

export default {
  private: {
    nowTime: "00:00",
    timer: null,
    cmds: [],
    favorites: []
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
    self.loadFavorites()
  },

  onShow() {
    this.loadFavorites()
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  normalizeFavorites(items) {
    var normalized = []
    var seen = {}
    if (!(items instanceof Array)) return normalized
    var lookup = this.$app.$def.shellData.buildCommandLookup()
    for (var i = 0; i < items.length; i++) {
      var cmd = items[i]
      if (typeof cmd !== "string") continue
      cmd = cmd.trim()
      if (!cmd || seen[cmd] || !lookup[cmd]) continue
      seen[cmd] = true
      normalized.push(cmd)
    }
    return normalized
  },

  loadFavorites() {
    var self = this
    file.readText({
      uri: FAVORITES_FILE,
      success: function(data) {
        var favorites = []
        try {
          favorites = JSON.parse(data.text)
        } catch (e) {}
        self.favorites = self.normalizeFavorites(favorites)
        self.buildCards()
      },
      fail: function() {
        self.favorites = []
        self.buildCards()
      }
    })
  },

  buildCards() {
    var cards = []
    var commandData = this.$app.$def.shellData.commandData
    for (var categoryId in commandData) {
      if (!commandData.hasOwnProperty(categoryId)) continue
      var items = commandData[categoryId].items
      for (var i = 0; i < items.length; i++) {
        var item = items[i]
        var isFavorited = this.isFavorited(item.cmd)
        cards.push({
          id: "favorite-" + item.cmd,
          cmd: item.cmd,
          label: this.$t(item.label),
          desc: this.$t(isFavorited ? "favorites.removeDesc" : "favorites.addDesc"),
          cardClass: isFavorited ? "card-primary" : "",
          subClass: isFavorited ? "card-sub-primary" : "",
          labelClass: item.danger ? "text-danger" : ""
        })
      }
    }
    this.cmds = cards
  },

  isFavorited(cmd) {
    for (var i = 0; i < this.favorites.length; i++) {
      if (this.favorites[i] === cmd) return true
    }
    return false
  },

  writeFavorites() {
    var self = this
    file.writeText({
      uri: FAVORITES_FILE,
      text: JSON.stringify(this.favorites),
      append: false,
      success: function() {
        self.buildCards()
      }
    })
  },

  toggleFavorite(cmd) {
    var next = []
    var removed = false
    for (var i = 0; i < this.favorites.length; i++) {
      if (this.favorites[i] === cmd) {
        removed = true
      } else {
        next.push(this.favorites[i])
      }
    }
    if (!removed) {
      next.unshift(cmd)
    }
    this.favorites = this.normalizeFavorites(next)
    this.writeFavorites()
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/back-page.css';
@import '../../common/card.css';

.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 176px; height: 110px; border-radius: 27px; padding-left: 14px; padding-right: 12px; margin-top: 8px; }
  .card-label { font-size: 28px; line-height: 34px; }
  .card-sub { font-size: 24px; line-height: 30px; margin-top: 4px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 196px; height: 110px; border-radius: 27px; padding-left: 14px; padding-right: 12px; margin-top: 8px; }
  .card-label { font-size: 28px; line-height: 34px; }
  .card-sub { font-size: 24px; line-height: 30px; margin-top: 4px; }
}
</style>
