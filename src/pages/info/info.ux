<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ categoryTitle }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>
      <div class="scroll-inner">

        <div class="card" for="{{cmds}}" tid="id" onclick="sendCmd($item.cmd, $item.danger)">
          <div class="card-left">
            <text class="card-label {{ $item.labelClass }}">{{ $item.label }}</text>
            <text class="card-sub">{{ $item.desc }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>

    <!-- 危险命令确认弹窗 -->
    <div show="{{showConfirm}}" class="confirm-overlay">
      <div class="confirm-box">
        <text class="confirm-title">{{ $t("confirm.title") }}</text>
        <text class="confirm-cmd">{{ confirmCmd }}</text>
        <text class="confirm-warn">{{ $t("confirm.warn") }}</text>
        <div class="confirm-btns">
          <div class="confirm-btn confirm-cancel" onclick="cancelDanger">
            <text class="confirm-btn-text">{{ $t("confirm.cancel") }}</text>
          </div>
          <div class="confirm-btn confirm-ok" onclick="confirmDanger">
            <text class="confirm-btn-text">{{ $t("confirm.ok") }}</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"

/* 命令数据：分类 ID → { i18nKey, items } */
var COMMAND_DATA = {
  templates: {
    i18nKey: "category.templates",
    items: [
      { cmd: "ls -l /",       label: "cmd.lsRoot",     desc: "cmd.lsRootDesc" },
      { cmd: "ls -la /data",  label: "cmd.lsData",     desc: "cmd.lsDataDesc" },
      { cmd: "ps",            label: "cmd.ps",         desc: "cmd.psDesc" },
      { cmd: "free",          label: "cmd.free",       desc: "cmd.freeDesc" },
      { cmd: "df",            label: "cmd.df",         desc: "cmd.dfDesc" },
      { cmd: "uname -a",      label: "cmd.unameA",     desc: "cmd.unameADesc" },
      { cmd: "dmesg",         label: "cmd.dmesg",      desc: "cmd.dmesgDesc" },
      { cmd: "uptime",        label: "cmd.uptime",     desc: "cmd.uptimeDesc" },
      { cmd: "ifconfig",      label: "cmd.ifconfig",   desc: "cmd.ifconfigDesc" },
      { cmd: "help",          label: "cmd.help",       desc: "cmd.helpDesc" }
    ]
  },
  file: {
    i18nKey: "category.file",
    items: [
      { cmd: "ls",      label: "cmd.ls",      desc: "cmd.lsDesc" },
      { cmd: "cat",     label: "cmd.cat",     desc: "cmd.catDesc" },
      { cmd: "cp",      label: "cmd.cp",      desc: "cmd.cpDesc" },
      { cmd: "mv",      label: "cmd.mv",      desc: "cmd.mvDesc" },
      { cmd: "rm",      label: "cmd.rm",      desc: "cmd.rmDesc",      danger: true },
      { cmd: "mkdir",   label: "cmd.mkdir",   desc: "cmd.mkdirDesc" },
      { cmd: "pwd",     label: "cmd.pwd",     desc: "cmd.pwdDesc" },
      { cmd: "dd",      label: "cmd.dd",      desc: "cmd.ddDesc",      danger: true }
    ]
  },
  system: {
    i18nKey: "category.system",
    items: [
      { cmd: "uname",   label: "cmd.uname",   desc: "cmd.unameDesc" },
      { cmd: "uptime",  label: "cmd.uptime",  desc: "cmd.uptimeDesc" },
      { cmd: "date",    label: "cmd.date",    desc: "cmd.dateDesc" },
      { cmd: "dmesg",   label: "cmd.dmesg",   desc: "cmd.dmesgDesc" },
      { cmd: "free",    label: "cmd.free",    desc: "cmd.freeDesc" },
      { cmd: "reboot",  label: "cmd.reboot",  desc: "cmd.rebootDesc",  danger: true }
    ]
  },
  process: {
    i18nKey: "category.process",
    items: [
      { cmd: "ps",      label: "cmd.ps",      desc: "cmd.psDesc" },
      { cmd: "sleep",   label: "cmd.sleep",   desc: "cmd.sleepDesc" },
      { cmd: "kill",    label: "cmd.kill",    desc: "cmd.killDesc",    danger: true }
    ]
  },
  network: {
    i18nKey: "category.network",
    items: [
      { cmd: "ifconfig",  label: "cmd.ifconfig",  desc: "cmd.ifconfigDesc" },
      { cmd: "ping",      label: "cmd.ping",      desc: "cmd.pingDesc" },
      { cmd: "curl",      label: "cmd.curl",      desc: "cmd.curlDesc" },
      { cmd: "nslookup",  label: "cmd.nslookup",  desc: "cmd.nslookupDesc" }
    ]
  }
}

export default {
  protected: { category: "", entry: "" },

  private: {
    nowTime: "00:00",
    timer: null,
    cmds: [],
    categoryTitle: "",
    showConfirm: false,
    confirmCmd: ""
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)

    var catData = COMMAND_DATA[self.category]
    if (catData) {
      self.categoryTitle = self.$t(catData.i18nKey)
      var items = []
      for (var i = 0; i < catData.items.length; i++) {
        var item = catData.items[i]
        items.push({
          cmd: item.cmd,
          label: self.$t(item.label),
          desc: self.$t(item.desc),
          danger: item.danger || false,
          labelClass: item.danger ? 'text-danger' : ''
        })
      }
      self.cmds = items
    } else {
      self.categoryTitle = self.category || ""
      self.cmds = []
    }
  },

  onDestroy() { clearInterval(this.timer) },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  sendCmd(cmd, danger) {
    var self = this
    if (danger) {
      vibrator.vibrate({ duration: 80 })
      self.confirmCmd = cmd
      self.showConfirm = true
      return
    }
    self.doNavigate(cmd)
  },

  confirmDanger() {
    var cmd = this.confirmCmd
    this.showConfirm = false
    this.confirmCmd = ""
    this.doNavigate(cmd)
  },

  cancelDanger() {
    this.showConfirm = false
    this.confirmCmd = ""
  },

  doNavigate(cmd) {
    var route = { uri: "/pages/terminal", params: { cmd: cmd } }
    if (this.entry === "terminal") {
      router.replace(route)
      return
    }
    router.push(route)
  },

  goBack() { router.back() }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000000; }
.content-full { width: 336px; height: 480px; flex-direction: column; }
.header-area { width: 336px; height: 102px; position: relative; }
.header-bg { width: 336px; height: 102px; }
.hd-time { position: absolute; left: 78px; top: 7px; width: 180px; height: 32px; text-align: center; font-size: 24px; font-weight: bold; color: rgba(255,255,255,0.6); }
.hd-title { position: absolute; left: 78px; top: 35px; width: 180px; height: 42px; text-align: center; font-size: 32px; font-weight: bold; color: #ffffff; }
.hd-back { position: absolute; left: 6px; top: 6px; width: 72px; height: 72px; }
.pill-header { display: none; }
.card { width: 324px; height: 112px; margin-top: 8px; background-color: #262626; border-radius: 36px; flex-direction: row; align-items: center; padding-left: 20px; padding-right: 20px; }
.card-left { flex-direction: column; flex: 1; }
.card-label { font-size: 32px; line-height: 40px; font-weight: bold; color: #ffffff; lines: 1; }
.card-sub { font-size: 28px; line-height: 37px; font-weight: bold; color: rgba(255,255,255,0.6); margin-top: 4px; lines: 1; }
.text-danger { color: #ff4444; }
.spacer { height: 20px; }
.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }

/* 确认弹窗 */
.confirm-overlay { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: rgba(0,0,0,0.88); flex-direction: column; align-items: center; justify-content: center; }
.confirm-box { width: 280px; height: 260px; background-color: #1a1a1a; border-radius: 36px; border-width: 2px; border-color: #ff4444; flex-direction: column; align-items: center; padding: 24px 16px; }
.confirm-title { font-size: 34px; color: #ff4444; font-weight: bold; margin-bottom: 12px; }
.confirm-cmd { font-size: 26px; color: #ffffff; font-weight: bold; margin-bottom: 8px; background-color: #000000; padding: 6px 16px; border-radius: 16px; }
.confirm-warn { font-size: 22px; color: rgba(255,255,255,0.5); text-align: center; margin-bottom: 16px; lines: 2; }
.confirm-btns { flex-direction: row; width: 240px; justify-content: space-between; }
.confirm-btn { width: 108px; height: 52px; border-radius: 24px; flex-direction: row; align-items: center; justify-content: center; }
.confirm-cancel { background-color: #333333; }
.confirm-ok { background-color: #cc0000; }
.confirm-btn-text { font-size: 26px; font-weight: bold; color: #ffffff; }

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .page { width: 192px; height: 490px; }
  .content-full { width: 192px; height: 490px; }
  .header-area { display: none; }
  .pill-header { display: flex; width: 192px; height: 92px; flex-direction: column; align-items: center; justify-content: flex-start; }
  .pill-more-wrap { width: 92px; height: 72px; border-radius: 32px; flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
  .pill-more { width: 92px; height: 72px; background-image: url(/common/back_capsule.png); background-size: 92px 72px; border-radius: 32px; }
  .hd-title { width: 192px; top: 22px; font-size: 22px; }
  .hd-back { left: 4px; top: 4px; width: 52px; height: 52px; }
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 176px; height: 110px; border-radius: 27px; padding-left: 14px; padding-right: 12px; margin-top: 8px; }
  .card-label { font-size: 28px; line-height: 34px; }
  .card-sub { font-size: 24px; line-height: 30px; margin-top: 4px; }
  .spacer { height: 16px; }
  .confirm-overlay { width: 192px; height: 490px; }
  .confirm-box { width: 168px; height: 230px; border-radius: 27px; padding: 16px 10px; }
  .confirm-title { font-size: 26px; margin-bottom: 8px; }
  .confirm-cmd { font-size: 20px; padding: 4px 10px; }
  .confirm-warn { font-size: 18px; margin-bottom: 12px; }
  .confirm-btns { width: 148px; }
  .confirm-btn { width: 66px; height: 42px; border-radius: 18px; }
  .confirm-btn-text { font-size: 20px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .page { width: 212px; height: 520px; }
  .content-full { width: 212px; height: 520px; }
  .header-area { display: none; }
  .pill-header { display: flex; width: 212px; height: 92px; flex-direction: column; align-items: center; justify-content: flex-start; }
  .pill-more-wrap { width: 102px; height: 72px; border-radius: 36px; flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
  .pill-more { width: 102px; height: 72px; background-image: url(/common/back_capsule.png); background-size: 102px 72px; border-radius: 36px; }
  .hd-title { width: 212px; top: 22px; font-size: 22px; }
  .hd-back { left: 4px; top: 4px; width: 52px; height: 52px; }
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 196px; height: 110px; border-radius: 27px; padding-left: 14px; padding-right: 12px; margin-top: 8px; }
  .card-label { font-size: 28px; line-height: 34px; }
  .card-sub { font-size: 24px; line-height: 30px; margin-top: 4px; }
  .spacer { height: 16px; }
  .confirm-overlay { width: 212px; height: 520px; }
  .confirm-box { width: 188px; height: 240px; border-radius: 27px; padding: 16px 10px; }
  .confirm-title { font-size: 26px; margin-bottom: 8px; }
  .confirm-cmd { font-size: 20px; padding: 4px 10px; }
  .confirm-warn { font-size: 18px; margin-bottom: 12px; }
  .confirm-btns { width: 164px; }
  .confirm-btn { width: 74px; height: 44px; border-radius: 20px; }
  .confirm-btn-text { font-size: 22px; }
}
</style>
