<template>
  <div class="page">
    <scroll class="content-full" scroll-y="true" bounces="true">
      <div class="header-area">
        <img src="/common/hd.png" class="header-bg" />
        <text class="hd-time">{{ nowTime }}</text>
        <text class="hd-title">{{ categoryTitle }}</text>
        <img src="/common/back.png" @click="goBack" class="hd-back" />
      </div>
      <div class="pill-header">
        <div class="pill-more-wrap" @click="goBack">
          <div class="pill-more"></div>
        </div>
      </div>
      <div class="scroll-inner">
        <div if="{{showEmpty}}" class="card">
          <div class="card-left">
            <text class="card-label">{{ $t("favorites.emptyTitle") }}</text>
            <text class="card-sub">{{ $t("favorites.emptyDesc") }}</text>
          </div>
        </div>

        <div class="card" for="{{cmds}}" tid="id" onclick="sendCmd($item.cmd, $item.danger)">
          <div class="card-left">
            <text class="card-label {{ $item.labelClass }}">{{ $item.label }}</text>
            <text class="card-sub">{{ $item.desc }}</text>
          </div>
        </div>

        <div class="spacer"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"
import prompt from "@system.prompt"

var DEBUG_FILE = "internal://files/debug_mode.json"
var FAVORITES_FILE = "internal://files/favorites.json"

export default {
  protected: { category: "", entry: "" },

  private: {
    nowTime: "00:00",
    timer: null,
    cmds: [],
    categoryTitle: "",
    showEmpty: false
  },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
    var commandData = self.$app.$def.shellData.commandData

    if (self.category === "favorites") {
      self.categoryTitle = self.$t("favorites.title")
      self.loadFavoriteCommands()
      return
    }

    var catData = commandData[self.category]
    if (catData) {
      self.categoryTitle = self.$t(catData.i18nKey)
      self.cmds = self.buildLocalizedItems(catData.items)
      self.showEmpty = false
    } else {
      self.categoryTitle = self.category || ""
      self.cmds = []
      self.showEmpty = false
    }
  },

  onDestroy() { clearInterval(this.timer) },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  buildLocalizedItems(items) {
    var localized = []
    for (var i = 0; i < items.length; i++) {
      var item = items[i]
      localized.push({
        cmd: item.cmd,
        label: this.$t(item.label),
        desc: this.$t(item.desc),
        danger: item.danger || false,
        labelClass: item.danger ? 'text-danger' : ''
      })
    }
    return localized
  },

  loadFavoriteCommands() {
    var self = this
    file.readText({
      uri: FAVORITES_FILE,
      success: function(data) {
        var favorites = []
        try {
          favorites = JSON.parse(data.text)
        } catch (e) {}
        self.applyFavoriteCommands(favorites)
      },
      fail: function() {
        self.cmds = []
        self.showEmpty = true
      }
    })
  },

  applyFavoriteCommands(favorites) {
    var lookup = this.$app.$def.shellData.buildCommandLookup()
    var items = []
    if (favorites instanceof Array) {
      for (var i = 0; i < favorites.length; i++) {
        var cmd = favorites[i]
        if (lookup[cmd]) {
          items.push(lookup[cmd])
        }
      }
    }
    this.cmds = this.buildLocalizedItems(items)
    this.showEmpty = this.cmds.length === 0
  },

  sendCmd(cmd, danger) {
    var self = this
    if (danger) {
      /* 检查调试模式 */
      file.readText({
        uri: DEBUG_FILE,
        success: function(data) {
          try {
            var json = JSON.parse(data.text)
            if (json.enabled === true) {
              /* 调试模式已开启：直接跳转 */
              self.doNavigate(cmd)
            } else {
              /* 非调试模式：系统提示 */
              prompt.showToast({ message: self.$t("confirm.needDebug") })
            }
          } catch(e) {
            prompt.showToast({ message: self.$t("confirm.needDebug") })
          }
        },
        fail: function() {
          prompt.showToast({ message: self.$t("confirm.needDebug") })
        }
      })
      return
    }
    self.doNavigate(cmd)
  },

  doNavigate(cmd) {
    var route = { uri: "/pages/terminal", params: { cmd: cmd } }
    if (this.entry === "terminal") {
      router.replace(route)
      return
    }
    router.push(route)
  },

  goBack() { router.back() }
}
</script>

<style>
@import '../../common/back-page.css';
@import '../../common/card.css';

.scroll-inner { margin-top: 0; padding: 0 6px 20px 6px; flex-direction: column; }

@media (shape: rect) {
  .scroll-inner { margin-top: -15px; }
}
@media (shape: pill-shaped) and (max-width: 100) {
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 176px; height: 110px; border-radius: 27px; padding-left: 14px; padding-right: 12px; margin-top: 8px; }
  .card-label { font-size: 28px; line-height: 34px; }
  .card-sub { font-size: 24px; line-height: 30px; margin-top: 4px; }
}
@media (shape: pill-shaped) and (min-width: 101) {
  .scroll-inner { padding: 0 8px 16px 8px; }
  .card { width: 196px; height: 110px; border-radius: 27px; padding-left: 14px; padding-right: 12px; margin-top: 8px; }
  .card-label { font-size: 28px; line-height: 34px; }
  .card-sub { font-size: 24px; line-height: 30px; margin-top: 4px; }
}
</style>
