<script>
import router from "@system.router"

export default {
  protected: { category: "" },
  private: { nowTime: "00:00", timer: null },

  onInit() {
    var self = this
    self.updateTime()
    self.timer = setInterval(function() { self.updateTime() }, 1000)
  },

  onDestroy() { clearInterval(this.timer) },

  updateTime() {
    var d = new Date()
    this.nowTime = ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2)
  },

  sendCmd(cmd) {
    router.push({ uri: "/pages/terminal", params: { cmd: cmd } })
  },

  goBack() { router.back() }
}
</script>

